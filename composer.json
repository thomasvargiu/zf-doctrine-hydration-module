{
  "name": "datasage/laminas-doctrine-hydration-module",
  "license": "MIT",
  "description": "Doctrine hydrators for Laminas Framework",
  "keywords": [
    "laminas",
    "doctrine",
    "hydrator"
  ],
  "authors": [
    {
      "name": "Toon Verwerft",
      "email": "toon.verwerft@phpro.be"
    },
    {
      "name": "Dan Johansson",
      "email": "datasge@gmail.com"
    }
  ],
  "extra": {
    "laminas": {
      "module": "Phpro\\DoctrineHydrationModule"
    }
  },
  "require": {
    "php": "^7.4 || ^8.0 || ^8.1",
    "doctrine/persistence": "^2.0.0 || ^3.0.0",
    "doctrine/doctrine-module": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "doctrine/instantiator": "^1.0.5",
    "laminas/laminas-servicemanager": "^3.3.2",
    "laminas/laminas-hydrator": "^3.0.0 || ^4.0.0",
    "doctrine/doctrine-laminas-hydrator": "^3.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3",
    "phpunit/phpunit": "^9.5.27",
    "doctrine/doctrine-orm-module": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "doctrine/doctrine-mongo-odm-module": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "doctrine/mongodb-odm": "^2.0",
    "dg/bypass-finals": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Phpro\\DoctrineHydrationModule\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhproTest\\DoctrineHydrationModule\\": "test/src/"
    }
  },
  "config": {
  }
}
